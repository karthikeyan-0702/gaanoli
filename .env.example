# ==============================================================================
# GaTube Configuration
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5174

# Database (PostgreSQL)
# Note: Host port is mapped to 5433 to prevent collision with other local instances
POSTGRES_USER=gatube
POSTGRES_PASSWORD=gatube_secret_change_in_prod
POSTGRES_DB=gatubedb
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1
DATABASE_URL=postgresql://gatube:gatube_secret_change_in_prod@127.0.0.1:5433/gatubedb

# Background Queue & Cache (Redis)
# Note: Host port is mapped to 6380 to prevent collision with other local instances
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

# Storage Service
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_SIZE_BYTES=524288000 # 500 MB

# YouTube Data API v3 (Used purely for metadata resolution and search discovery)
# Leave empty to use fallback/curated mock data during development
YOUTUBE_API_KEY=

# --- Security (required for production / Render) ---
# Generate: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me-not-for-production-use
AUTH_DEV_MODE=true
# Production: AUTH_DEV_MODE=false, use password hashes (npm run hash-password --workspace=@gatube/api "your-password")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-local-only
# ADMIN_PASSWORD_HASH=scrypt$...
GUEST_USERNAME=guest
GUEST_PASSWORD=change-guest-local-only
# GUEST_PASSWORD_HASH=scrypt$...

# Optional Firebase (future); login uses SESSION_SECRET + accounts above
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web Application (Vite)
# Relative API (recommended): browser only hits YOUR domain — friend on Sophos never contacts youtube.com
VITE_USE_RELATIVE_API=true
VITE_PRIVACY_MODE=true
# Only if UI and API are on different hosts (not needed for Render all-in-one or Vercel rewrites)
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=GaTube

# API privacy: strip Google/YouTube URLs from JSON responses (default on)
CLIENT_PRIVACY_MODE=true

# Production on Render (single URL): serve apps/web/dist from the API process
SERVE_WEB_STATIC=false
WEB_DIST_PATH=apps/web/dist

# After Render deploy, set both to your public URL, e.g. https://gaanoli.onrender.com
# WEB_URL=https://gaanoli.onrender.com
# API_URL=https://gaanoli.onrender.com
